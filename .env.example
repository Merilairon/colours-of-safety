# Copy to .env and adjust as needed. docker compose reads this automatically.

# --- Database (PostGIS) ---
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=colours_of_safety

# --- Auth ---
# Use a long random string in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Seeded default accounts (created on first boot) ---
REVIEWER_EMAIL=reviewer@coloursofsafety.com
REVIEWER_PASSWORD=reviewer123

SUPER_ADMIN_EMAIL=superadmin@coloursofsafety.com
SUPER_ADMIN_PASSWORD=superadmin123

# --- Session cookie ---
# The session JWT is stored in an HttpOnly, SameSite=Strict cookie.
# Defaults to Secure when NODE_ENV=production. Set to false only for plain-HTTP
# local setups (docker compose on http://localhost).
COOKIE_SECURE=false

# --- Transactional email (verification, email change, password reset) ---
# Any SMTP provider works (Postmark, Resend, Amazon SES, Brevo, Mailgun, ...).
# Without SMTP_HOST no email is sent. For local development only, set
# MAIL_TRANSPORT=log to print emails (including links) to the backend log;
# this is ignored when NODE_ENV=production.
APP_URL=http://localhost:8080
MAIL_FROM=Colours of Safety <no-reply@coloursofsafety.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# MAIL_TRANSPORT=log   # only honoured by `npm run start:dev` (NODE_ENV != production)

# --- CORS ---
# Production domain or '*' for dev. Default: https://coloursofsafety.com
CORS_ORIGIN=https://coloursofsafety.com

# --- Frontend ---
# Host port the app is served on (http://localhost:FRONTEND_PORT)
FRONTEND_PORT=8080
